# Copy to .env and fill in. Never commit .env.
PAYPAL_BASE=https://api-m.sandbox.paypal.com
FUNDER_CLIENT_ID=
FUNDER_CLIENT_SECRET=
FUNDER_WEBHOOK_ID=
SUPPLIER_CLIENT_ID=
SUPPLIER_CLIENT_SECRET=
SUPPLIER_WEBHOOK_ID=
SUPPLIER_EMAIL=
LARKSPUR_CLIENT_ID=
LARKSPUR_CLIENT_SECRET=
SECONDSHOT_CLIENT_ID=
SECONDSHOT_CLIENT_SECRET=
BUYER_LARKSPUR_EMAIL=
BUYER_SECONDSHOT_EMAIL=
WALKIN_EMAIL=
ANTHROPIC_API_KEY=
# Default model claude-opus-5-5. ANALYST_MODE mock = no AI calls (stored demo replies).
ANTHROPIC_MODEL=claude-haiku-5-5
ANALYST_MODE=mock
ANALYST_RUNS_PER_HOUR=10
ADMIN_TOKEN=
APP_BASE_URL=http://localhost:3000
# Leave empty locally to use the built in PGlite database in ./.data
DATABASE_URL=
