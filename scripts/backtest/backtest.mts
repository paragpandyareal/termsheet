// Backtest of the plain scorecard (no AI) on 100 synthetic buyers. Free: no AI and no PayPal calls.
//   node scripts/backtest/backtest.mts            prints the table and writes docs/BACKTEST.md
// Same seed every time, so the numbers are reproducible.
import fs from 'node:fs';
import { score, type ScoreInput } from '../../lib/scorecard/scorecard.ts';

let seed = 20261112;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) % 4294967296) / 4294967296);
const int = (a: number, b: number) => Math.floor(a + rnd() * (b - a + 1));
const pick = <T,>(xs: T[]) => xs[Math.floor(rnd() * xs.length)];
const MEDIAN = 115000;

type Buyer = { group: string; label: 'GOOD' | 'BAD'; hidden?: string; input: ScoreInput };

function healthy(): Buyer {
  const avg = int(80000, 150000), orders = int(8, 24), inv = int(4, 18);
  const sales = int(1200000, 3000000);
  return { group: 'A. Healthy café', label: 'GOOD', input: { paidOrdersWithSupplier: orders, invoicesTotal: inv, invoicesLateOrReminded: int(0, Math.floor(inv * 0.15)), disputes: pick([0, 0, 0, 1]), orderCents: Math.round(avg * (0.8 + rnd())), buyerSales30dCents: sales, buyerAvgOrderCents: avg, supplierMedianOrderCents: MEDIAN, repayment: pick(['NONE', 'ON_TIME', 'ON_TIME']) } };
}
function visibleRisk(): Buyer {
  const avg = int(60000, 140000), inv = int(5, 15), sales = int(250000, 900000);
  const kind = pick(['late', 'disputes', 'failed', 'oversized']);
  return { group: 'B. Risk the numbers show', label: 'BAD', input: { paidOrdersWithSupplier: int(2, 15), invoicesTotal: inv,
    invoicesLateOrReminded: kind === 'late' ? int(Math.ceil(inv * 0.5), inv) : int(1, Math.ceil(inv * 0.4)), disputes: kind === 'disputes' ? int(2, 4) : int(0, 1),
    orderCents: kind === 'oversized' ? avg * int(4, 8) : Math.round(avg * (1 + rnd() * 2)), buyerSales30dCents: sales, buyerAvgOrderCents: avg, supplierMedianOrderCents: MEDIAN,
    repayment: kind === 'failed' ? 'FAILED_90D' : pick(['NONE', 'ON_TIME']) } };
}
// Hidden risk: the PayPal numbers look normal. The only warning sign sits in a document, the shipping address or the order mix,
// which the scorecard does not take as input. This is the gap the AI analyst is there to cover.
function hiddenRisk(): Buyer {
  const b = healthy();
  b.input.paidOrdersWithSupplier = int(6, 14);
  b.input.orderCents = Math.round((b.input.buyerAvgOrderCents || MEDIAN) * (1.2 + rnd() * 0.7));
  return { ...b, group: 'C. Risk only the documents show', label: 'BAD', hidden: pick(['letter contradicts the form', 'ships to a freight forwarder', 'order mix does not fit a café', 'instruction hidden in a document']) };
}
function thinFile(): Buyer {
  return { group: 'D. New café, thin file', label: 'GOOD', input: { paidOrdersWithSupplier: int(0, 3), invoicesTotal: int(0, 2), invoicesLateOrReminded: 0, disputes: 0, orderCents: int(60000, 200000), buyerSales30dCents: pick([null, int(400000, 1500000)]), buyerAvgOrderCents: null, supplierMedianOrderCents: MEDIAN, repayment: 'NONE' } };
}

const buyers: Buyer[] = [...Array(25)].flatMap(() => [healthy(), visibleRisk(), hiddenRisk(), thinFile()]);
const rows = new Map<string, { n: number; approve: number; tierA: number; noApprove: number; label: string }>();
for (const b of buyers) {
  const s = score(b.input);
  const r = rows.get(b.group) || { n: 0, approve: 0, tierA: 0, noApprove: 0, label: b.label };
  r.n++; s.ceiling.outcome === 'APPROVE' ? r.approve++ : r.noApprove++; if (s.ceiling.tier === 'A') r.tierA++;
  rows.set(b.group, r);
}
const sorted = [...rows.entries()].sort();
const table = ['| Group | Buyers | Truth | Scorecard approves | of which full $5,000 limit | Scorecard does not approve |', '|---|---|---|---|---|---|',
  ...sorted.map(([g, r]) => `| ${g} | ${r.n} | ${r.label === 'GOOD' ? 'Should get terms' : 'Should not get terms'} | ${r.approve} | ${r.tierA} | ${r.noApprove} |`)].join('\n');
console.log(table);

const C = rows.get('C. Risk only the documents show')!, B = rows.get('B. Risk the numbers show')!, A = rows.get('A. Healthy café')!, D = rows.get('D. New café, thin file')!;
const md = `# Scorecard backtest (no AI)

Generated by \`node scripts/backtest/backtest.mts\`. 100 synthetic buyers, fixed random seed, so anyone can rerun it and get the same numbers. No AI and no PayPal calls.

${table}

## What this shows
- Healthy cafés: the scorecard approves ${A.approve} of ${A.n}, ${A.tierA} of them at the full $5,000 limit.
- Risk the numbers show (late invoices, disputes, a failed repayment or an oversized order): it stops ${B.noApprove} of ${B.n}. The ${B.approve} it still approves have one bad number among good ones, and ${B.approve - B.tierA} of those get only the smaller $2,500 limit. A plain points table is lenient when only one thing is wrong, which is a known trade-off of simple scorecards.
- Risk only the documents show: it approves ${C.approve} of ${C.n}, ${C.tierA} at the full limit. The warning signs are in a reference letter, the shipping address or the order mix, which the scorecard does not read. **That is the gap the AI analyst covers**, and why the AI may only tighten a decision, never loosen it.
- New cafés with a thin file: the scorecard approves ${D.approve} of ${D.n}, all at the smaller limit at most (${D.tierA} at the full limit). The other ${D.noApprove} are not approved, and the AI cannot override that.

## Honest limits
- The buyers are synthetic and the "truth" labels are set by how each group is built. Group C is built so the risk sits outside the scorecard's inputs, so this measures the size of the gap, not the AI.
- How the AI does on real cases from the demo is in \`docs/AI_EVAL.md\` (repeated live runs on the hosted demo).
`;
fs.writeFileSync('docs/BACKTEST.md', md);
console.log('\nWrote docs/BACKTEST.md');
